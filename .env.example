# Local/manual build example. Production values are managed by
# production/compose.yml + /var/tools/env/production.env.
#
# NEXT_PUBLIC_BASE_PATH is intentionally not set here because every app has a
# different production path and local `pnpm dev` should keep simple localhost
# URLs. Docker Compose injects the correct basePath per application at build.

NEXT_PUBLIC_CLEARFRAME_URL=https://tooldock.pro/image/remove-metadata
NEXT_PUBLIC_SKYCONVERT_URL=https://tooldock.pro/image/heic-to-jpg
NEXT_PUBLIC_LEAFSIZE_URL=https://tooldock.pro/image/resize-images
NEXT_PUBLIC_WAVECUT_URL=https://tooldock.pro/audio/cut-audio
NEXT_PUBLIC_SOUNDSHIFT_URL=https://tooldock.pro/audio/convert-audio

NEXT_PUBLIC_SITE_URL=https://tooldock.pro/image/remove-metadata
NEXT_PUBLIC_HEIC_SITE_URL=https://tooldock.pro/image/heic-to-jpg
NEXT_PUBLIC_RESIZER_SITE_URL=https://tooldock.pro/image/resize-images
NEXT_PUBLIC_WAVECUT_SITE_URL=https://tooldock.pro/audio/cut-audio
NEXT_PUBLIC_SOUNDSHIFT_SITE_URL=https://tooldock.pro/audio/convert-audio

# AdSense values are public identifiers. Keep live requests disabled until the
# domain has been approved and consent handling is ready.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_PRIMARY=
NEXT_PUBLIC_ADSENSE_SLOT_SECONDARY=
NEXT_PUBLIC_ADS_PREVIEW=false
