# Copy this file on the server to:
#   /var/tools/env/production.env
# Then edit the values there. Do not commit the real production file.

DOMAIN=tooldock.pro
IMAGE_TAG=latest

# AdSense stays disabled until the domain is approved.
ADSENSE_ENABLED=false
ADSENSE_CLIENT=

# Keep separate slots per tool so revenue can be measured independently.
CLEARFRAME_ADSENSE_SLOT_PRIMARY=
CLEARFRAME_ADSENSE_SLOT_SECONDARY=
SKYCONVERT_ADSENSE_SLOT_PRIMARY=
SKYCONVERT_ADSENSE_SLOT_SECONDARY=
LEAFSIZE_ADSENSE_SLOT_PRIMARY=
LEAFSIZE_ADSENSE_SLOT_SECONDARY=
WAVECUT_ADSENSE_SLOT_PRIMARY=
WAVECUT_ADSENSE_SLOT_SECONDARY=
SOUNDSHIFT_ADSENSE_SLOT_PRIMARY=
SOUNDSHIFT_ADSENSE_SLOT_SECONDARY=
